{
  "name": "esencial",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "predev": "node api/scripts/ensure-dev-vars.ts",
    "dev": "node api/scripts/dev.ts",
    "dev:web": "VITE_API_URL=${VITE_API_URL:-http://127.0.0.1:8789} pnpm build && wrangler dev --ip ${ESENCIAL_IP:-127.0.0.1} --port 8787 --var API_ORIGIN:${API_ORIGIN:-http://127.0.0.1:8789}",
    "dev:api": "wrangler dev -c api/wrangler.toml --ip ${ESENCIAL_IP:-127.0.0.1} --port 8789 --persist-to .wrangler/state --var WEB_ORIGIN:${WEB_ORIGIN:-http://127.0.0.1:8787}",
    "build": "pnpm --filter web build",
    "e2e": "pnpm --filter @esencial/e2e test",
    "e2e:check": "pnpm --filter @esencial/e2e isolation-check",
    "test": "pnpm --filter api test && pnpm --filter web test",
    "typecheck": "pnpm -r typecheck",
    "deploy": "pnpm build && wrangler deploy -c api/wrangler.toml && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply esencial --local -c api/wrangler.toml --persist-to .wrangler/state",
    "db:migrate:remote": "wrangler d1 migrations apply esencial --remote -c api/wrangler.toml",
    "lint": "biome check . && pnpm --filter @esencial/web check:tokens",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "husky": "^9.1.7",
    "wrangler": "4.128.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260815.1": true,
    "workerd@1.20260831.1": true
  },
  "packageManager": "pnpm@12.4.2"
}
