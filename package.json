{
  "name": "esencial",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "predev": "node api/scripts/ensure-dev-vars.ts",
    "dev": "pnpm build && wrangler dev",
    "build": "pnpm --filter web build",
    "e2e": "pnpm --filter @esencial/e2e test",
    "test": "pnpm --filter api test && pnpm --filter web test",
    "typecheck": "pnpm -r typecheck",
    "deploy": "pnpm build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply esencial --local",
    "db:migrate:remote": "wrangler d1 migrations apply esencial --remote"
  },
  "devDependencies": {
    "wrangler": "4.128.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260815.1": true,
    "workerd@1.20260831.1": true
  },
  "packageManager": "pnpm@11.25.0",
  "volta": {
    "node": "24.20.0"
  }
}
