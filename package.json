{
  "name": "esencial",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "web",
    "api"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "wrangler dev",
    "build": "npm run build -w web",
    "test": "npm run test -w api && npm run test -w web",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 execute esencial --local --file=api/schema.sql",
    "db:migrate:remote": "wrangler d1 execute esencial --remote --file=api/schema.sql"
  },
  "devDependencies": {
    "wrangler": "4.128.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260815.1": true,
    "workerd@1.20260831.1": true
  }
}
