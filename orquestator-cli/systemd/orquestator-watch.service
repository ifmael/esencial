[Unit]
Description=Orquestator watch (cola de Linear)
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=simple
WorkingDirectory=%h/Projects/esencial
EnvironmentFile=-%h/.config/orquestator/env
# Una unidad de usuario no puede añadir grupos suplementarios (systemd falla
# con 216/GROUP), así que se conserva newgrp. No pide contraseña si el usuario
# ya pertenece al grupo docker; el preflight de `run`/`watch` avisa si no.
ExecStart=/usr/bin/newgrp docker -c "/bin/bash -lc 'exec node orquestator-cli/bin/orquestator.mjs watch --max-parallel 1'"
Restart=on-failure
RestartSec=30
KillSignal=SIGTERM
TimeoutStopSec=1h

[Install]
WantedBy=default.target
